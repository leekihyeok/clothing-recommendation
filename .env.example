# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 git에 올라가지 않습니다.

# --- 공통 ---
# Docker (infra/docker-compose.yml). 개발용 계정이라 비밀번호가 파일에 그대로 있음
DATABASE_URL=postgres://cr:cr_dev_password@localhost:5433/clothing_reco
REDIS_URL=redis://localhost:6380

# --- API 서버 (NestJS) ---
API_PORT=4000
MODEL_SERVICE_URL=http://localhost:8100

# --- 외부 API (0단계에서 발급) ---
# 네이버 개발자센터 검색 API (선택, 3단계 블로그 신호용)
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
KAKAO_REST_API_KEY=
# Kakao login (stage 7): REST API 키 → 클라이언트 시크릿. Needed when the secret is switched on in the console (KOE010 otherwise).
KAKAO_CLIENT_SECRET=
# Where Kakao sends the user back; must match the Redirect URI registered on the REST API key.
KAKAO_REDIRECT_URI=http://localhost:5180/auth/kakao/callback
TMAP_APP_KEY=
DATA_GO_KR_SERVICE_KEY=
# AI: 지금은 Gemini 무료 등급, 나중에 Claude로 바꿀 수 있음 (AI_PROVIDER=gemini | anthropic)
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- 클라이언트 (Vite, VITE_ 로 시작해야 브라우저에 노출됨) ---
# 카카오 JavaScript 키 (지도 표시용, REST 키와 같은 앱에서 발급)
VITE_KAKAO_MAP_JS_KEY=
# Admin page (/admin): Kakao account ids (users.kakao_id), comma separated.
ADMIN_KAKAO_IDS=
# Pipeline AI calls per model per day (free quota ~500); the rest is kept for people using the app.
AI_BATCH_DAILY_CAP=420
# Public transit routes (lab.odsay.com, server key). Without it: Kakao Map directions link only.
ODSAY_API_KEY=
# Optional: Kakao app admin key, to unlink the app when someone deletes their account.
KAKAO_ADMIN_KEY=
